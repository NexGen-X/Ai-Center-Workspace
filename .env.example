# ==============================================================================
# AI Agent Command Center — Environment Configuration Template
# Copy this file to .env and configure your local or production secrets.
# DO NOT commit real secrets or production passwords to version control!
# ==============================================================================

# Application Server Port
PORT=3000

# Runtime Environment (development | production | test)
NODE_ENV=production

# PostgreSQL Connection String (PostgreSQL 16 with pgvector extension)
DATABASE_URL=postgres://routex:your_db_password_here@127.0.0.1:5432/ai_center?sslmode=disable

# AES-256-GCM Encryption Key for Model Provider API Keys (Must be >= 32 characters)
ENCRYPTION_KEY=replace-with-your-secure-32-character-secret-key-here!

# Default HQ Workspace Identifier
DEFAULT_WORKSPACE_ID=ws-default-command-center
